{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Oximut mutant list, schema version 1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "mutants",
    "diagnostics"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "mutants": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mutant"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "runId": false,
    "baseline": false,
    "summary": false,
    "cache": false,
    "resources": false
  },
  "$defs": {
    "position": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "offset",
        "line",
        "column"
      ],
      "properties": {
        "offset": {
          "type": "integer",
          "minimum": 0,
          "description": "Zero-based UTF-8 byte offset."
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1,
          "description": "One-based UTF-16 column."
        }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "$ref": "#/$defs/position"
        },
        "end": {
          "$ref": "#/$defs/position"
        }
      }
    },
    "mutant": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "file",
        "operator",
        "original",
        "replacement",
        "location",
        "code",
        "map"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "operator": {
          "type": "string"
        },
        "original": {
          "type": "string"
        },
        "replacement": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "location": {
          "$ref": "#/$defs/location"
        },
        "map": {}
      }
    }
  }
}
