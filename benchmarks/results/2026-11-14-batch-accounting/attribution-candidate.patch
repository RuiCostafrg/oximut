+fn gap(event: &str) {
+    let Some(directory) = std::env::var_os("OXIMUT_BATCH_GAP_TRACE") else { return };
+    let mut now = libc::timespec { tv_sec: 0, tv_nsec: 0 };
+    unsafe { libc::clock_gettime(libc::CLOCK_MONOTONIC, &mut now); }
+    if let Ok(mut file) = fs::OpenOptions::new().create(true).append(true).open(
+        Path::new(&directory).join(format!("{}.jsonl", std::process::id()))) {
+        let _ = writeln!(file, "{}", serde_json::json!({"ns": now.tv_sec as u64 * 1_000_000_000 + now.tv_nsec as u64, "event":event}));
+    }
+}
