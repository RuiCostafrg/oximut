":{"end":{"column":17,"line":35},"start":{"column":7,"line":35}}},{"id":"69","mutatorName":"ConditionalExpression","replacement":"false","statusReason":"expected 'medium' to be 'small' // Object.is equality","status":"Killed","static":false,"testsCompleted":1,"killedBy":["5"],"coveredBy":["5"],"location":{"end":{"column":17,"line":35},"start":{"column":7,"line":35}}},{"id":"70","mutatorName":"EqualityOperator","replacement":"value <= 10","statusReason":"expected 'small' to be 'medium' // Object.is equality","status":"Killed","static":false,"testsCompleted":1,"killedBy":["5"],"coveredBy":["5"],"location":{"end":{"column":17,"line":35},"start":{"column":7,"line":35}}},{"id":"71","mutatorName":"EqualityOperator","replacement":"value >= 10","statusReason":"expected 'medium' to be 'small' // Object.is equality","status":"Killed","static":false,"testsCompleted":1,"killedBy":["5"],"coveredBy":["5"],"location":{"end":{"column":17,"line":35},"start":{"column":7,"line":35}}},{"id":"72","mutatorName":"StringLiteral","replacement":"\"\"","statusReason":"expected '' to be 'small' // Object.is equality","status":"Killed","static":false,"testsCompleted":1,"killedBy":["5"],"coveredBy":["5"],"location":{"end":{"column":33,"line":35},"start":{"column":26,"line":35}}},{"id":"73","mutatorName":"ConditionalExpression","replacement":"true","statusReason":"expected 'medium' to be 'large' // Object.is equality","status":"Killed","static":false,"testsCompleted":1,"killedBy":["5"],"coveredBy":["5"],"location":{"end":{"column":18,"line":36},"start":{"column":7,"line":36}}},{"id":"74","mutatorName":"ConditionalExpression","replacement":"false","statusReason":"expected 'large' to be 'medium' // Object.is equality","status":"Killed","static":false,"testsCompleted":1,"killedBy":["5"],"coveredBy":["5"],"location":{"end":{"column":18,"line":36},"start":{"column":7,"line":36}}},{"id":"75","mutatorName":"EqualityOperator","replacement":"value < 20","statusReason":"expected 'large' to be 'medium' // Object.is equality","status":"Killed","static":false,"testsCompleted":1,"killedBy":["5"],"coveredBy":["5"],"location":{"end":{"column":18,"line":36},"start":{"column":7,"line":36}}},{"id":"76","mutatorName":"EqualityOperator","replacement":"value > 20","statusReason":"expected 'large' to be 'medium' // Object.is equality","status":"Killed","static":false,"testsCompleted":1,"killedBy":["5"],"coveredBy":["5"],"location":{"end":{"column":18,"line":36},"start":{"column":7,"line":36}}},{"id":"77","mutatorName":"StringLiteral","replacement":"\"\"","statusReason":"expected '' to be 'medium' // Object.is equality","status":"Killed","static":false,"testsCompleted":1,"killedBy":["5"],"coveredBy":["5"],"location":{"end":{"column":35,"line":36},"start":{"column":27,"line":36}}},{"id":"78","mutatorName":"StringLiteral","replacement":"\"\"","statusReason":"expected '' to be 'large' // Object.is equality","status":"Killed","static":false,"testsCompleted":1,"killedBy":["5"],"coveredBy":["5"],"location":{"end":{"column":17,"line":37},"start":{"column":10,"line":37}}},{"id":"79","mutatorName":"BlockStatement","replacement":"{}","statusReason":"expected undefined to be false // Object.is equality","status":"Killed","static":false,"testsCompleted":1,"killedBy":["6"],"coveredBy":["6"],"location":{"end":{"column":2,"line":42},"start":{"column":77,"line":40}}},{"id":"80","mutatorName":"ConditionalExpression","replacement":"true","statusReason":"expected true to be false // Object.is equality","status":"Killed","static":false,"testsCompleted":1,"killedBy":["6"],"coveredBy":["6"],"location":{"end":{"column":30,"line":41},"start":{"column":10,"line":41}}},{"id":"81","mutatorName":"ConditionalExpression","replacement":"false","statusReason":"expected false to be true // Object.is equality","status":"Killed","static":false,"testsCompleted":1,"killedBy":["6"],"coveredBy":["6"],"location":{"end":{"column":30,"line":41},"start":{"column":10,"line":41}}},{"id":"82","mutatorName":"LogicalOperator","replacement":"primary && secondary","statusReason":"expected false to be true // Object.is equality","status":"Killed","static":false,"testsCompleted":1,"killedBy":["6"],"coveredBy":["6"],"location":{"end":{"column":30,"line":41},"start":{"column":10,"line":41}}}],"source":"export function clamp(value: number, lower: number, upper: number): number {\n  if (value < lower) return lower;\n  if (value > upper) return upper;\n  return value;\n}\n\nexport function classifyScore(score: number): string {\n  if (score < 0) return 'negative';\n  if (score >= 90) return 'excellent';\n  if (score >= 60) return 'passing';\n  return 'failing';\n}\n\nexport function applyDiscount(price: number, percent: number): number {\n  if (price <= 0 || percent <= 0) return price;\n  if (percent >= 100) return 0;\n  return price - (price * percent) / 100;\n}\n\nexport function shippingCost(weight: number, expedited: boolean): number {\n  if (weight <= 0) return 0;\n  const base = weight <= 2 ? 5 : weight <= 10 ? 10 : 18;\n  return expedited ? base + 7 : base;\n}\n\nexport function canAccess(\n  age: number,\n  hasPass: boolean,\n  isSuspended: boolean,\n): boolean {\n  return age >= 18 && hasPass && !isSuspended;\n}\n\nexport function describeRange(value: number): string {\n  if (value < 10) return 'small';\n  if (value <= 20) return 'medium';\n  return 'large';\n}\n\nexport function combineFlags(primary: boolean, secondary: boolean): boolean {\n  return primary || secondary;\n}\n"}},"schemaVersion":"1.0","thresholds":{"high":80,"low":60,"break":null},"testFiles":{"fixtures/pure/test/logic.test.ts":{"tests":[{"id":"0","name":"clamp keeps values inside the bounds and returns the nearest bound outside"},{"id":"1","name":"classifyScore classifies negative, failing, passing, and excellent scores at boundaries"},{"id":"2","name":"applyDiscount preserves invalid prices and discounts, and caps full discounts at zero"},{"id":"3","name":"shippingCost uses weight tiers and adds the expedited fee"},{"id":"4","name":"canAccess requires an adult, a pass, and an active account"},{"id":"5","name":"describeRange and combineFlags uses inclusive upper boundary for medium"},{"id":"6","name":"describeRange and combineFlags combines either true flag"}],"source":"import { describe, expect, it } from 'vitest';\nimport {\n  applyDiscount,\n  canAccess,\n  clamp,\n  classifyScore,\n  combineFlags,\n  describeRange,\n  shippingCost,\n} from '../src/logic.js';\n\ndescribe('clamp', () => {\n  it('keeps values inside the bounds and returns the nearest bound outside', () => {\n    expect(clamp(4, 0, 10)).toBe(4);\n    expect(clamp(-1, 0, 10)).toBe(0);\n    expect(clamp(11, 0, 10)).toBe(10);\n  });\n});\n\ndescribe('classifyScore', () => {\n  it('classifies negative, failing, passing, and excellent scores at boundaries', () => {\n    expect(classifyScore(-1)).toBe('negative');\n    expect(classifyScore(0)).toBe('failing');\n    expect(classifyScore(59)).toBe('failing');\n    expect(classifyScore(60)).toBe('passing');\n    expect(classifyScore(89)).toBe('passing');\n    expect(classifyScore(90)).toBe('excellent');\n  });\n});\n\ndescribe('applyDiscount', () => {\n  it('preserves invalid prices and discounts, and caps full discounts at zero', () => {\n    expect(applyDiscount(-5, 20)).toBe(-5);\n    expect(applyDiscount(100, 0)).toBe(100);\n    expect(applyDiscount(100, 25)).toBe(75);\n    expect(applyDiscount(100, 100)).toBe(0);\n  });\n});\n\ndescribe('shippingCost', () => {\n  it('uses weight tiers and adds the expedited fee', () => {\n    expect(shippingCost(0, false)).toBe(0);\n    expect(shippingCost(2, false)).toBe(5);\n    expect(shippingCost(3, false)).toBe(10);\n    expect(shippingCost(10, true)).toBe(17);\n    expect(shippingCost(11, true)).toBe(25);\n  });\n});\n\ndescribe('canAccess', () => {\n  it('requires an adult, a pass, and an active account', () => {\n    expect(canAccess(18, true, false)).toBe(true);\n    expect(canAccess(17, true, false)).toBe(false);\n    expect(canAccess(18, false, false)).toBe(false);\n    expect(canAccess(18, true, true)).toBe(false);\n  });\n});\n\ndescribe('describeRange and combineFlags', () => {\n  it('uses inclusive upper boundary for medium', () => {\n    expect(describeRange(9)).toBe('small');\n    expect(describeRange(10)).toBe('medium');\n    expect(describeRange(20)).toBe('medium');\n    expect(describeRange(21)).toBe('large');\n  });\n\n  it('combines either true flag', () => {\n    expect(combineFlags(false, false)).toBe(false);\n    expect(combineFlags(true, false)).toBe(true);\n    expect(combineFlags(false, true)).toBe(true);\n    expect(combineFlags(true, true)).toBe(true);\n  });\n});\n"}},"projectRoot":"/root/.t3/scratch/2026-10-23-stryker-for-node-is-really-d7dbed62","config":{"mutate":["fixtures/pure/src/**/*.ts"],"ignorePatterns":["/target/**","/benchmarks/results/**","/.oximut/**","/.stryker-tmp*/**"],"testRunner":"vitest","vitest":{"configFile":"benchmarks/config/vitest-pure.mjs","related":true},"coverageAnalysis":"perTest","concurrency":1,"checkers":[],"incremental":false,"reporters":["json","progress"],"jsonReporter":{"fileName":"/root/.t3/scratch/2026-10-23-stryker-for-node-is-really-d7dbed62/benchmarks/results/2026-10-23-m0-arm64/measured-05-pure-stryker/report.json"},"tempDirName":".stryker-tmp-pure","cleanTempDir":true,"configFile":"benchmarks/config/pure.mjs","allowConsoleColors":true,"checkerNodeArgs":[],"commandRunner":{"command":"npm test"},"clearTextReporter":{"allowColor":true,"allowEmojis":false,"logTests":true,"maxTestsToLog":3,"reportTests":true,"reportMutants":true,"reportScoreTable":true,"skipFull":false},"dashboard":{"baseUrl":"https://dashboard.stryker-mutator.io/api/reports","reportType":"full"},"dryRunOnly":false,"eventReporter":{"baseDir":"reports/mutation/events"},"ignoreStatic":false,"incrementalFile":"reports/stryker-incremental.json","force":false,"fileLogLevel":"off","inPlace":false,"logLevel":"info","maxConcurrentTestRunners":9007199254740991,"maxTestRun