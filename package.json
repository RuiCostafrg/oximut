{
  "name": "oximut",
  "version": "1.0.0-rc.1",
  "private": true,
  "type": "module",
  "description": "Rust/Oxc mutation testing with a Vitest adapter \u2014 feasibility prototype",
  "engines": {
    "node": "26.3.1"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "format": "cd packages/vitest-adapter && biome format --write .",
    "format:check": "cd packages/vitest-adapter && biome format .",
    "lint": "cd packages/vitest-adapter && biome lint .",
    "typecheck": "tsc -p packages/vitest-adapter/tsconfig.json",
    "test": "npm run test:fixtures && npm run test:adapter && npm run test:benchmarks",
    "test:fixtures": "vitest run --config fixtures/pure/vitest.config.ts && vitest run --config fixtures/stateful/vitest.config.ts",
    "test:adapter": "node --test packages/vitest-adapter/test/*.test.mjs",
    "test:benchmarks": "python3 -m unittest discover -s benchmarks/tests -v",
    "benchmark": "python3 benchmarks/run.py",
    "experiment": "node packages/vitest-adapter/experiment.mjs --output .oximut/experiment.json"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "4.1.12",
    "ajv": "8.20.0",
    "typescript": "7.0.2",
    "vitest": "4.1.12"
  },
  "overrides": {
    "typed-rest-client": {
      "qs": "6.16.1"
    },
    "@stryker-mutator/core": {
      "minimatch": "11.0.3"
    }
  },
  "license": "MIT"
}
